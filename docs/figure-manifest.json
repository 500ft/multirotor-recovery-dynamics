{
  "schema_version": "1.0",
  "project": "Multirotor Recovery Dynamics",
  "figures": [
    {
      "id": "qdrone-development-response",
      "evidence_type": "continuous response from public development observations",
      "scope": "QDrone2 original MPC, selected discharge; no recovery labels",
      "generator": "Analysis/qdrone_response.py",
      "command": "python -m Analysis.qdrone_response --fetch --cache /tmp/multirotor-qdrone-source --output Data/qdrone-response/results.json --figure Figures/qdrone-development-response.png",
      "inputs": [
        "Data/qdrone-response/sources.json",
        "Data/qdrone-response/protocol.json"
      ],
      "outputs": [
        "Figures/qdrone-development-response.png"
      ],
      "data_outputs": [
        "Data/qdrone-response/results.json"
      ],
      "attribution": "Borbolla-Burillo et al., Experimental Setup and Experimental Results, doi:10.5281/zenodo.19464105, CC BY 4.0; metrics and plot derived here"
    },
    {
      "id": "release-recovery-simulation",
      "evidence_type": "deterministic 6-DoF simulation",
      "generator": "Analysis/run_release_recovery.py",
      "command": "python -m Analysis.run_release_recovery",
      "inputs": [
        "Analysis/sim_release_recovery.py",
        "Analysis/run_release_recovery.py"
      ],
      "outputs": [
        "Figures/release_recovery_timeseries.png",
        "Figures/release_recovery_timeseries.pdf",
        "Figures/release_recovery_envelope.png",
        "Figures/release_recovery_envelope.pdf"
      ],
      "data_outputs": [
        "Data/release_recovery_results.json"
      ],
      "notes": "Uses encoded parameter tiers and placeholder or catalog-derived values; it is not based on assembled-hardware measurements.",
      "scope": "Historical designed aircraft"
    },
    {
